local service = 9661
local secret = "33c4eb06-e149-43fd-a328-b042251cccc4"
local useNonce = true

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local StarterGui = game:GetService("StarterGui")

local function onMessage(msg)
	StarterGui:SetCore("ChatMakeSystemMessage", { Text = "[Platoboost] " .. msg })
end

local fRequest = request or http_request or syn.request
local fSetClipboard = setclipboard or toclipboard
local fGetHwid = gethwid or function() return tostring(player.UserId) end

local function lEncode(tbl) return HttpService:JSONEncode(tbl) end
local function lDecode(str) return HttpService:JSONDecode(str) end

local function lDigest(input)
	local out = ""
	for i = 1, #input do out ..= string.format("%02x", string.byte(input, i)) end
	return out
end

local host = "https://api.platoboost.app"
local ok, res = pcall(function() return fRequest({ Url = host .. "/public/connectivity", Method = "GET" }) end)
if not ok or not res or (res.StatusCode ~= 200 and res.StatusCode ~= 429) then
	host = "https://api.platoboost.net"
end

local function generateNonce()
	local s = ""
	for _ = 1, 16 do s ..= string.char(math.random(97, 122)) end
	return s
end

-- == Verify Key ==
local function verifyKey(key)
	local url = string.format("%s/public/whitelist/%s?identifier=%s&key=%s", host, service, lDigest(fGetHwid()), key)
	local res = fRequest({ Url = url, Method = "GET" })
	if not res then return onMessage("No response from server.") end
	local data = lDecode(res.Body)
	if data.success and data.data.valid then
		onMessage("Key verified successfully!")
		return true
	else
		onMessage("Invalid or expired key.")
		return false
	end
end

-- == Get Link ==
local function copyLink()
	local res = fRequest({
		Url = host .. "/public/start",
		Method = "POST",
		Headers = { ["Content-Type"] = "application/json" },
		Body = lEncode({
			service = service,
			identifier = lDigest(fGetHwid()),
		}),
	})
	if res and res.StatusCode == 200 then
		local data = lDecode(res.Body)
		if data.success and data.data.url then
			if fSetClipboard then
				fSetClipboard(data.data.url)
				onMessage("Copied key link to clipboard!")
			else
				onMessage("Copy manually: " .. data.data.url)
			end
		end
	else
		onMessage("Failed to fetch key link.")
	end
end

