--== CONFIGURATION ==--
local service = 9661 -- your Platoboost service ID
local secret = "33c4eb06-e149-43fd-a328-b042251cccc4"
local useNonce = true

--== CHAT MESSAGE FUNCTION ==--
local function onMessage(message)
	game:GetService("StarterGui"):SetCore("ChatMakeSystemMessage", { Text = "[Platoboost] " .. message })
end

repeat task.wait() until game:IsLoaded() and game.Players.LocalPlayer

--== SAFE GLOBAL FUNCTION SETUP ==--
local fSetClipboard = setclipboard or toclipboard
local fRequest = request or http_request or syn.request
local HttpService = game:GetService("HttpService")
local fGetHwid = gethwid or function()
	return tostring(game:GetService("Players").LocalPlayer.UserId)
end

local cachedLink, cachedTime = "", 0
local function lEncode(tbl) return HttpService:JSONEncode(tbl) end
local function lDecode(str) return HttpService:JSONDecode(str) end

local function lDigest(input)
	local bytes = {}
	for i = 1, #input do
		table.insert(bytes, string.byte(input, i))
	end
	local hex = ""
	for _, b in ipairs(bytes) do
		hex = hex .. string.format("%02x", b)
	end
	return hex
end

--== CONNECTIVITY CHECK ==--
local host = "https://api.platoboost.app"
local ok, resp = pcall(function()
	return fRequest({ Url = host .. "/public/connectivity", Method = "GET" })
end)
if not ok or not resp or (resp.StatusCode ~= 200 and resp.StatusCode ~= 429) then
	host = "https://api.platoboost.net"
end

--== LINK CACHE ==--
local function cacheLink()
	if cachedTime + (10 * 60) < os.time() then
		local res = fRequest({
			Url = host .. "/public/start",
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = lEncode({
				service = service,
				identifier = lDigest(fGetHwid()),
			}),
		})
		if res and res.StatusCode == 200 then
			local data = lDecode(res.Body)
			if data.success and data.data and data.data.url then
				cachedLink = data.data.url
				cachedTime = os.time()
				return true, cachedLink
			else
				onMessage(data.message or "Error while retrieving link.")
			end
		else
			onMessage("Failed to connect to Platoboost.")
		end
	end
	return true, cachedLink
end

--== NONCE ==--
local function generateNonce()
	local str = ""
	for _ = 1, 16 do
		str = str .. string.char(math.random(97, 122))
	end
	return str
end

--== KEY REDEMPTION ==--
local function redeemKey(key)
	local nonce = generateNonce()
	local endpoint = string.format("%s/public/redeem/%s", host, tostring(service))
	local body = {
		identifier = lDigest(fGetHwid()),
		key = key,
	}
	if useNonce then body.nonce = nonce end

	local res = fRequest({
		Url = endpoint,
		Method = "POST",
		Headers = { ["Content-Type"] = "application/json" },
		Body = lEncode(body),
	})
	if not res then
		onMessage("No response from server.")
		return false
	end

	local data = lDecode(res.Body)
	if data.success and data.data.valid then
		if not useNonce or data.data.hash == lDigest("true-" .. nonce .. "-" .. secret) then
			onMessage("Key redeemed successfully!")
			return true
		else
			onMessage("Failed to verify response integrity.")
		end
	else
		onMessage(data.message or "Invalid key.")
	end
	return false
end

--== VERIFY KEY ==--
local requestSending = false
local function verifyKey(key)
	if requestSending then
		onMessage("Wait before sending another request.")
		return false
	end
	requestSending = true

	local nonce = generateNonce()
	local url = string.format(
		"%s/public/whitelist/%s?identifier=%s&key=%s%s",
		host,
		tostring(service),
		lDigest(fGetHwid()),
		key,
		useNonce and "&nonce=" .. nonce or ""
	)

	local res = fRequest({ Url = url, Method = "GET" })
	requestSending = false

	if not res then
		onMessage("No response from server.")
		return false
	end

	local data = lDecode(res.Body)
	if data.success and data.data.valid then
		onMessage("Key verified successfully!")
		return true
	elseif key:sub(1, 5) == "FREE_" then
		return redeemKey(key)
	else
		onMessage("Invalid or expired key.")
		return false
	end
end

--== COPY LINK ==--
local function copyLink()
	local success, link = cacheLink()
	if success and link ~= "" then
		if fSetClipboard then
			fSetClipboard(link)
			onMessage("Copied link to clipboard!")
		else
			onMessage("Copy manually: " .. link)
		end
	else
		onMessage("Failed to get key link.")
	end
end

