--!strict
--// Platoboost Key System UI by YuriOnTop

local Platoboost = loadstring(game:HttpGet("https://api.platoboost.com/v1/script-library"))()

--! configuration
local service = 9661  -- replace with your Platoboost service ID
local secret = "33c4eb06-e149-43fd-a328-b042251cccc4"  -- replace with your Platoboost secret
local useNonce = true

--! UI Setup
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "PlatoboostKeyUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = game:GetService("CoreGui")

local Frame = Instance.new("Frame")
Frame.Size = UDim2.new(0, 350, 0, 180)
Frame.Position = UDim2.new(0.5, -175, 0.5, -90)
Frame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
Frame.BorderSizePixel = 0
Frame.Parent = ScreenGui

local UICorner = Instance.new("UICorner", Frame)
UICorner.CornerRadius = UDim.new(0, 8)

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 30)
Title.BackgroundTransparency = 1
Title.Text = "Platoboost Key System"
Title.Font = Enum.Font.GothamBold
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.TextSize = 18
Title.Parent = Frame

local KeyBox = Instance.new("TextBox")
KeyBox.Size = UDim2.new(0.9, 0, 0, 30)
KeyBox.Position = UDim2.new(0.05, 0, 0.3, 0)
KeyBox.PlaceholderText = "Enter your key here..."
KeyBox.Font = Enum.Font.Gotham
KeyBox.Text = ""
KeyBox.TextSize = 14
KeyBox.TextColor3 = Color3.fromRGB(255, 255, 255)
KeyBox.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
KeyBox.BorderSizePixel = 0
KeyBox.Parent = Frame
Instance.new("UICorner", KeyBox)

local GetKey = Instance.new("TextButton")
GetKey.Size = UDim2.new(0.42, 0, 0, 30)
GetKey.Position = UDim2.new(0.05, 0, 0.55, 0)
GetKey.Text = "Get Key"
GetKey.Font = Enum.Font.GothamBold
GetKey.TextSize = 14
GetKey.TextColor3 = Color3.fromRGB(255, 255, 255)
GetKey.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
GetKey.Parent = Frame
Instance.new("UICorner", GetKey)

local VerifyKey = GetKey:Clone()
VerifyKey.Text = "Verify Key"
VerifyKey.Position = UDim2.new(0.53, 0, 0.55, 0)
VerifyKey.Parent = Frame

local JoinDiscord = Instance.new("TextButton")
JoinDiscord.Size = UDim2.new(0.9, 0, 0, 30)
JoinDiscord.Position = UDim2.new(0.05, 0, 0.78, 0)
JoinDiscord.Text = "Join Discord"
JoinDiscord.Font = Enum.Font.GothamBold
JoinDiscord.TextSize = 14
JoinDiscord.TextColor3 = Color3.fromRGB(255, 255, 255)
JoinDiscord.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
JoinDiscord.Parent = Frame
Instance.new("UICorner", JoinDiscord)

--! logic
GetKey.MouseButton1Click:Connect(function()
	setclipboard("https://platoboost.com/service/"..service)
	game.StarterGui:SetCore("SendNotification", {
		Title = "Platoboost";
		Text = "Key link copied to clipboard!";
		Duration = 4;
	})
end)

VerifyKey.MouseButton1Click:Connect(function()
	local key = KeyBox.Text
	if key == "" then
		game.StarterGui:SetCore("SendNotification", {
			Title = "Error";
			Text = "Please enter your key.";
			Duration = 3;
		})
		return
	end

	local valid, err = Platoboost:VerifyKey(service, secret, key, useNonce)
	if valid then
		game.StarterGui:SetCore("SendNotification", {
			Title = "Success";
			Text = "Key verified!";
			Duration = 3;
		})
		ScreenGui:Destroy()
	else
		game.StarterGui:SetCore("SendNotification", {
			Title = "Invalid Key";
			Text = err or "Verification failed.";
			Duration = 3;
		})
	end
end)

JoinDiscord.MouseButton1Click:Connect(function()
	setclipboard("https://discord.gg/YOURSERVER") -- replace this link
	game.StarterGui:SetCore("SendNotification", {
		Title = "Platoboost";
		Text = "Discord invite copied!";
		Duration = 3;
	})
end)
